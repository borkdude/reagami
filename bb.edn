{:paths ["src" "test" "script"]
 :tasks {:requires ([babashka.fs :as fs]
                    [clojure.string :as str])
         install {:task (shell "pnpm install")}
         dev {:depends [install]
              :task (shell "pnpm watch")}
         test-jvm {:requires ([clojure.test :as t]
                              [ssr-jvm-test])
                   :task (let [{:keys [fail error]} (t/run-tests 'ssr-jvm-test)]
                           (when (pos? (+ fail error)) (System/exit 1)))}
         test-nbb {:task (shell "pnpm test:nbb")}
         test {:depends [install test-jvm test-nbb]
               :task (shell "pnpm test")}
         sync-create-app {:requires ([tasks])
                          :task (tasks/sync-create-app)}
         publish {:depends [test]
                  :requires ([tasks])
                  :task (tasks/publish)}
         swap-old {:task (let [current (slurp "src/reagami/core.cljc")
                               with-old-ns (str/replace current "reagami.core" "reagami.old")]
                           (spit "src/reagami/old.cljc" with-old-ns))}}}
